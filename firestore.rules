rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function room(roomCode) {
      return get(/databases/$(database)/documents/rooms/$(roomCode)).data;
    }

    function isTeacher(roomCode) {
      return signedIn() && room(roomCode).teacherSessionId == request.auth.uid;
    }

    // Milestone 2: shared by magic/{teamId}, magicEvents/{eventId}, and answerProgress —
    // verifies the caller actually owns the named player doc (the same get()+ownerUid-compare
    // shape used everywhere else in this file, just parameterized by which player id to check).
    function isPlayerOwner(roomCode, playerId) {
      return playerId != null
        && get(/databases/$(database)/documents/rooms/$(roomCode)/players/$(playerId)).data.ownerUid == request.auth.uid;
    }

    // Milestone 4: inventory is now a fixed-shape count map ({power_surge, score_seal,
    // rose_shield, illusion} -> {available, consumed}), not an array of item instances — this
    // rules language has no way to search an arbitrary-length array for a predicate match, only
    // compare fixed field paths, which is exactly why the app-level type was redesigned this
    // way (see types/game.ts's MagicInventory). Milestone 4.1 adds illusion as a 4th entry.
    function hasAnyMagicItem(inventory) {
      return inventory.power_surge.available > 0 || inventory.power_surge.consumed > 0
        || inventory.score_seal.available > 0 || inventory.score_seal.consumed > 0
        || inventory.rose_shield.available > 0 || inventory.rose_shield.consumed > 0
        || inventory.illusion.available > 0 || inventory.illusion.consumed > 0;
    }

    // True when exactly one of the four inventory entries holds the single starting item
    // (available == 1, consumed == 0) and the other three are completely untouched (available
    // == 0, consumed == 0) — the only shape the inventory may ever be in before the mission
    // starts, whether this is the team's first pick or the Nth time the captain changed it.
    function isSingleStartingItemInventory(inventory) {
      return (
        inventory.power_surge.available == 1 && inventory.power_surge.consumed == 0
        && inventory.score_seal.available == 0 && inventory.score_seal.consumed == 0
        && inventory.rose_shield.available == 0 && inventory.rose_shield.consumed == 0
        && inventory.illusion.available == 0 && inventory.illusion.consumed == 0
      ) || (
        inventory.score_seal.available == 1 && inventory.score_seal.consumed == 0
        && inventory.power_surge.available == 0 && inventory.power_surge.consumed == 0
        && inventory.rose_shield.available == 0 && inventory.rose_shield.consumed == 0
        && inventory.illusion.available == 0 && inventory.illusion.consumed == 0
      ) || (
        inventory.rose_shield.available == 1 && inventory.rose_shield.consumed == 0
        && inventory.power_surge.available == 0 && inventory.power_surge.consumed == 0
        && inventory.score_seal.available == 0 && inventory.score_seal.consumed == 0
        && inventory.illusion.available == 0 && inventory.illusion.consumed == 0
      ) || (
        inventory.illusion.available == 1 && inventory.illusion.consumed == 0
        && inventory.power_surge.available == 0 && inventory.power_surge.consumed == 0
        && inventory.score_seal.available == 0 && inventory.score_seal.consumed == 0
        && inventory.rose_shield.available == 0 && inventory.rose_shield.consumed == 0
      );
    }

    // "Choosing (or changing) the one starting item": before must be either untouched
    // (hasAnyMagicItem false — the very first pick) or already a single legal starting-item
    // pick (a change), after must be a single legal starting-item pick of any type, and no
    // entry's `consumed` may ever move (it can't, pre-start — activation/boss rewards are both
    // 'playing'-only — but this is checked directly rather than assumed). This is what makes "A
    // -> B leaves only B, never A+B" true at the rules layer, not just the app layer, for
    // both the first choice AND every subsequent change.
    function choseExactlyOneItem(before, after) {
      return (!hasAnyMagicItem(before) || isSingleStartingItemInventory(before))
        && isSingleStartingItemInventory(after)
        && after.power_surge.consumed == before.power_surge.consumed
        && after.score_seal.consumed == before.score_seal.consumed
        && after.rose_shield.consumed == before.rose_shield.consumed
        && after.illusion.consumed == before.illusion.consumed;
    }

    // Mirrors lib/magic.ts's isEligibleQuestionIndex / getMagicActivationWindow so a holder's
    // queuedEffect write can be validated server-side, not just trusted from the client.
    function isEligibleQuestionIndex(roomCode, index) {
      return index > 0 && index < room(roomCode).questionIds.size() - 1;
    }

    // Milestone 2.2: activation is a room.status == 'playing' concept only — selecting a
    // starting item (lobby) never implies immediate use, and there is no lobby activation
    // window anymore. Once playing, activation is valid for the WHOLE lifecycle of the current
    // question (answering or reveal — no longer time-gated), always targeting
    // currentQuestionIndex + 1.
    // Milestone 4: phase == 'main' additionally guards against activation leaking into the
    // 3-question boss phase (status stays 'playing' throughout both, currentQuestionIndex
    // stays frozen during boss, so without this check the index-match alone wouldn't catch it).
    function isValidActivationWindow(roomCode, index) {
      return room(roomCode).status == 'playing'
        && room(roomCode).phase == 'main'
        && index == room(roomCode).currentQuestionIndex + 1
        && isEligibleQuestionIndex(roomCode, index);
    }

    // Reads the sibling magic/{teamId} doc's state as it will exist *after* this same atomic
    // write commits — used only to correlate a 'queued' magicEvents record against the
    // queuedEffect transition happening in the same transaction, so a student can never create
    // a magicEvents doc independently of a real, validated queuedEffect.
    function magicAfter(roomCode, teamId) {
      return getAfter(/databases/$(database)/documents/rooms/$(roomCode)/magic/$(teamId)).data;
    }

    match /rooms/{roomCode} {
      // MVP: ผู้ใช้ที่ยืนยันตัวตนแบบ anonymous อ่านข้อมูลห้องได้เพื่อเข้าร่วมด้วยรหัส
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.teacherSessionId == request.auth.uid
        && request.resource.data.roomCode == roomCode
        && request.resource.data.status == 'waiting';
      allow update: if isTeacher(roomCode);
      allow delete: if false;

      // One persistent player record per student (Milestone 1: individual join, team
      // assignment is teacher-controlled). doc id is a deterministic hash of studentNumber,
      // so uniqueness-within-room and refresh/reconnect are enforced by create-vs-update
      // semantics at the application layer (see joinRoom in firebaseService.ts) plus the
      // create/update rules below as a defense-in-depth backstop.
      match /players/{playerId} {
        // get vs list matters here: a genuinely new student's join transaction must read
        // this doc (which doesn't exist yet) to decide reconnect-vs-new-vs-duplicate before
        // ever calling create. That get has no `resource` to check ownership against, so it
        // needs its own room-state-based allowance — list stays teacher-only so students can
        // never enumerate the roster.
        //
        // Clause order matters: the "waiting && unlocked" clause is placed before the
        // ownerUid clause so it short-circuits first. If it were evaluated after a false
        // ownerUid clause, accessing resource.data on a null resource (nonexistent doc)
        // would error out the whole allow — denying even legitimate teacher/room reads.
        allow get: if isTeacher(roomCode)
          || (signedIn() && room(roomCode).status == 'waiting' && room(roomCode).teamsLocked == false)
          || (signedIn() && resource.data.ownerUid == request.auth.uid);
        allow list: if isTeacher(roomCode);
        // teamsLocked == false blocks direct Firestore creation of a genuinely new player
        // once the teacher has locked teams — this backstops the app-level late-join guard
        // in joinRoom, so it holds even against a client bypassing the app code. Reconnect
        // is unaffected: an existing doc id makes the operation an update, not a create.
        allow create: if signedIn()
          && room(roomCode).status == 'waiting'
          && room(roomCode).teamsLocked == false
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.teamId == null
          && request.resource.data.currentRound == room(roomCode).currentRound
          && request.resource.data.score == 0
          && request.resource.data.currentQuestionIndex == 0
          && request.resource.data.submitted == false;
        // Student self-update: every other field — ownerUid, studentNumber, displayName,
        // teamId, status, currentQuestionIndex, submitted, joinedAt — must stay bit-identical
        // to the existing doc, or the write is rejected outright. A student can never reassign
        // their own team, impersonate another ownerUid, or alter identity fields after
        // creation. The isTeacher branch remains the only path that can ever change teamId
        // (team randomize/lock).
        //
        // Milestone 4: which array a student may touch depends on room.phase — main-phase
        // answers only ever touch ['answers', 'score'], boss-phase answers only ever touch
        // ['bossAnswers']. This is what makes "boss answers do not affect the 100-point
        // knowledge score" true at the rules layer too, not just in app code.
        allow update: if isTeacher(roomCode) || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && room(roomCode).status == 'playing'
          && request.resource.data.currentQuestionIndex == resource.data.currentQuestionIndex
          && request.resource.data.submitted == resource.data.submitted
          && request.resource.data.status == resource.data.status
          && (
            (
              room(roomCode).phase == 'main'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'score'])
              && (
                request.resource.data.answers.size() == resource.data.answers.size() + 1
                || request.resource.data.answers.size() == resource.data.answers.size()
              )
              && request.resource.data.score >= resource.data.score - 1
              && request.resource.data.score <= resource.data.score + 1
              && request.resource.data.score >= 0
              && request.resource.data.score <= 10
            )
            ||
            (
              room(roomCode).phase == 'boss'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bossAnswers'])
              && (
                request.resource.data.bossAnswers.size() == resource.data.bossAnswers.size() + 1
                || request.resource.data.bossAnswers.size() == resource.data.bossAnswers.size()
              )
              && request.resource.data.bossAnswers.size() <= 3
            )
          )
        );
        allow delete: if false;
      }

      // Milestone 2: team magic items. Score/scoring-affecting fields are computed client
      // and server side purely from players + magicEvents (never stored) — these documents
      // only ever hold item/queue/holder bookkeeping.
      //
      // Milestone 4.1: magicHolderPlayerId is now the team's ELECTED CAPTAIN (see
      // captainVotes/captainVoteProgress below), never randomly assigned. It is written ONLY by
      // the teacher-unconditional branch below — neither holder-writable sub-branch below
      // touches it (the starting-item branch pins it equal to its previous value; the
      // activation branch's hasOnly(['queuedEffect']) structurally excludes it). Finalization is
      // deliberately teacher-only rather than student-triggered-on-last-vote, because a
      // student-triggered write could never be validated here as actually reflecting the
      // correct vote tally (this rules language cannot aggregate/count across a collection) —
      // see gameService.ts's doc comment on castCaptainVote for the full rationale. This makes
      // "only teacher may reopen/reset/finalize manually" true by construction, not just policy.
      match /magic/{teamId} {
        // Opponents can currently see every team's holder/inventory/queuedEffect/shield state
        // via this broad signedIn() read — tracked as a known remaining gameplay-privacy gap,
        // not addressed by this pass (see the hardening report). Everything below only tightens
        // what a holder is allowed to *write*.
        allow read: if signedIn();
        allow create: if isTeacher(roomCode);
        // The holder may only perform two narrow, self-contained transitions: choosing (or,
        // while still 'waiting', changing) their one starting item — always exactly one entry,
        // never more than one type at a time — or activating it (queuedEffect null -> non-null).
        // Anything else (resolution, expiry, captain election/reset, inventory reset) is
        // teacher-only, riding inside already-teacher-gated operations (lockTeams/advanceQuestion/
        // prepareNextRound/stopRound/closeRoom/finalizeCaptainElection/resetCaptainElection).
        allow update: if isTeacher(roomCode) || (
          signedIn() && isPlayerOwner(roomCode, resource.data.magicHolderPlayerId) && (
            (
              // Starting-item choice: the team's first pick (inventory untouched -> exactly one
              // entry) OR a captain changing an already-chosen pick to a different one (exactly
              // one entry -> exactly one entry, of any type combination) — choseExactlyOneItem
              // covers both shapes. Only while waiting+locked (which also makes this permanently
              // unreachable once the mission actually starts), holder/team identity untouched.
              choseExactlyOneItem(resource.data.inventory, request.resource.data.inventory)
              && request.resource.data.magicHolderPlayerId == resource.data.magicHolderPlayerId
              && request.resource.data.teamId == resource.data.teamId
              && room(roomCode).status == 'waiting'
              && room(roomCode).teamsLocked == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inventory'])
            )
            ||
            (
              // Activation: the item type must have at least one currently-available count for
              // this team; the target/self-target rule must match the item type; the affected
              // question must be an eligible next question, requested only during a valid
              // activation window (never question 1/10, never mid-question, never during the
              // boss phase); no unknown fields; inventory itself is untouched here (consumption
              // happens later, at resolution, which is teacher-only) — hasOnly(['queuedEffect'])
              // below already guarantees this structurally, since nothing else is in the diff.
              // Milestone 4: multiple teams may queue a score_seal at the same target — there is
              // no "already targeted" restriction here anymore, matching the app-level stacking
              // change (seals resolve multiplicatively, see computeHostileMultiplier).
              // Milestone 4.1: illusion joins power_surge as a valid, self-only-targetable
              // activation type; its hiddenChoiceId cannot be validated here at all (the
              // question bank isn't Firestore data — it's a static client bundle, exactly like
              // correctChoiceId is never rules-validated for saveAnswer either), so it's simply
              // an allowed optional key, trusted from the app layer like the rest of the
              // question-bank-dependent logic in this codebase.
              resource.data.queuedEffect == null
              && request.resource.data.queuedEffect != null
              && request.resource.data.queuedEffect.keys().hasOnly(['id', 'itemType', 'sourceTeamId', 'targetTeamId', 'affectedQuestionIndex', 'createdAt', 'hiddenChoiceId'])
              && request.resource.data.queuedEffect.itemType in ['power_surge', 'score_seal', 'illusion']
              && resource.data.inventory[request.resource.data.queuedEffect.itemType].available > 0
              && request.resource.data.queuedEffect.sourceTeamId == teamId
              && (
                (
                  (request.resource.data.queuedEffect.itemType == 'power_surge' || request.resource.data.queuedEffect.itemType == 'illusion')
                  && request.resource.data.queuedEffect.targetTeamId == teamId
                )
                || (
                  request.resource.data.queuedEffect.itemType == 'score_seal'
                  && request.resource.data.queuedEffect.targetTeamId != teamId
                  && exists(/databases/$(database)/documents/rooms/$(roomCode)/magic/$(request.resource.data.queuedEffect.targetTeamId))
                )
              )
              && isValidActivationWindow(roomCode, request.resource.data.queuedEffect.affectedQuestionIndex)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['queuedEffect'])
            )
          )
        );
        allow delete: if false;
      }

      // Flat, teacher-listable activation-lifecycle log. A holder may only create their own
      // team's 'queued'/'rejected' record naming themselves as actor — every later status
      // transition (applied/blocked/expired) is teacher-only, via the same resolution/reset
      // operations noted above.
      match /magicEvents/{eventId} {
        // Milestone 4: all team members (not just the teacher) must be able to see incoming
        // seal counts, queued power_surge status, and resolved shield/seal outcomes for their
        // own and opposing teams — this is the same documented signedIn()-broad-read trade-off
        // already used for magic/{teamId} and rosters/{teamId}.
        allow read: if signedIn();
        // A holder may create their own team's audit record, but never independently of a real
        // activation: 'queued' records must exactly match the queuedEffect transition landing in
        // the *same atomic write* (checked via getAfter() — this is what makes forging a scoring
        // event without a corresponding, rules-validated queuedEffect impossible). 'rejected'
        // records carry no scoring weight and have no queuedEffect to correlate against, so only
        // holder-identity + shape are checked. Every other status (applied/blocked/expired) can
        // only ever be produced by the teacher-only update rule below, driven by
        // resolveQuestionMagicEffects/expireQueuedMagicEffects — a holder can never directly
        // mark their own or anyone else's event resolved.
        allow create: if isTeacher(roomCode) || (
          signedIn()
          && request.resource.data.keys().hasOnly(['itemType', 'actorPlayerId', 'sourceTeamId', 'targetTeamId', 'affectedQuestionIndex', 'status', 'round', 'createdAt', 'resolvedAt'])
          && request.resource.data.itemType in ['power_surge', 'score_seal', 'rose_shield', 'illusion']
          // Milestone 2.1: the event's round must be the room's CURRENT round — otherwise a
          // stale/forged write could carry a multiplier into a round it wasn't created in.
          // Competition scoring filters on this too (lib/magic.ts), so this is defense in depth.
          && request.resource.data.round == room(roomCode).currentRound
          && request.resource.data.createdAt == request.time
          && isPlayerOwner(roomCode, get(/databases/$(database)/documents/rooms/$(roomCode)/magic/$(request.resource.data.sourceTeamId)).data.magicHolderPlayerId)
          && request.resource.data.actorPlayerId == get(/databases/$(database)/documents/rooms/$(roomCode)/magic/$(request.resource.data.sourceTeamId)).data.magicHolderPlayerId
          && (
            (
              request.resource.data.status == 'queued'
              && request.resource.data.resolvedAt == null
              && magicAfter(roomCode, request.resource.data.sourceTeamId).queuedEffect.id == eventId
              && magicAfter(roomCode, request.resource.data.sourceTeamId).queuedEffect.itemType == request.resource.data.itemType
              && magicAfter(roomCode, request.resource.data.sourceTeamId).queuedEffect.sourceTeamId == request.resource.data.sourceTeamId
              && magicAfter(roomCode, request.resource.data.sourceTeamId).queuedEffect.targetTeamId == request.resource.data.targetTeamId
              && magicAfter(roomCode, request.resource.data.sourceTeamId).queuedEffect.affectedQuestionIndex == request.resource.data.affectedQuestionIndex
            )
            || (
              request.resource.data.status == 'rejected'
              && request.resource.data.resolvedAt == request.time
            )
          )
        );
        allow update: if isTeacher(roomCode);
        allow delete: if false;
      }

      // Milestone 2: display-only team roster (teamId/teamName/playerId/displayName only —
      // never ownerUid, answers, score, choices, or correctness). Always fully rebuilt by
      // randomizeTeams, so it is teacher-write-only; students never touch it.
      match /rosters/{teamId} {
        allow read: if signedIn();
        allow write: if isTeacher(roomCode);
      }

      // Milestone 2: one doc per player recording only which question they most recently
      // answered (no choice, no correctness, no score) — the "teammates answered X/Y" signal.
      // The doc id *is* the player id, so this is a direct get()+ownerUid check identical in
      // shape to every other per-player authorization in this file; requiring the written
      // teamId to match the player's own current teamId stops a student from ever writing
      // progress under a team they don't belong to.
      match /answerProgress/{playerId} {
        allow read: if signedIn();
        // Only the exact documented fields, only for the room's current question (never a past
        // or future one — the write must name precisely room.questionIds[currentQuestionIndex],
        // so nothing else validates), only for the room's current round (Milestone 2.1 — this
        // collection is never wiped on a round transition, so without this a stale entry from
        // an earlier round could misreport a teammate as "already answered" if a later round
        // happens to reuse the same questionId), only while a round is actually playing, and
        // only the player's own current team (blocking a stale/forged teamId).
        allow write: if isTeacher(roomCode) || (
          signedIn()
          && isPlayerOwner(roomCode, playerId)
          && request.resource.data.keys().hasOnly(['teamId', 'questionId', 'currentRound', 'answeredAt'])
          && request.resource.data.teamId == get(/databases/$(database)/documents/rooms/$(roomCode)/players/$(playerId)).data.teamId
          && room(roomCode).status == 'playing'
          && request.resource.data.questionId == room(roomCode).questionIds[room(roomCode).currentQuestionIndex]
          && request.resource.data.currentRound == room(roomCode).currentRound
        );
        allow delete: if false;
      }

      // Milestone 4.1: team captain election. PRIVATE per-voter record of who they actually
      // voted for — readable only by the teacher and the voter themselves, never broadly
      // readable. This is what makes "students see only โหวตแล้ว X/Y คน, not live candidate
      // totals" enforceable at the rules layer: no classmate's client has a rules-legal way to
      // read this collection at all. See captainVoteProgress below for the broadly-readable
      // counterpart that powers the X/Y count.
      match /captainVotes/{playerId} {
        allow get: if isTeacher(roomCode) || isPlayerOwner(roomCode, playerId);
        allow list: if isTeacher(roomCode);
        // Self-voting is allowed — targetPlayerId == playerId simply satisfies the same
        // team-match checks as voting for anyone else. "Students may change their vote until
        // finalized" is what makes this a plain overwrite-by-id write, exactly like
        // answerProgress/{playerId} above. electionAttempt must match the team's CURRENT
        // attempt (read fresh from magic/{teamId}) — this is what makes a teacher's
        // reopen/reset actually take effect: a vote cast under a superseded attempt can never
        // be re-submitted to count toward the new one by replaying an old write. Blocked
        // entirely once magicHolderPlayerId is already set ("prevent voting after
        // finalization").
        allow write: if isTeacher(roomCode) || (
          signedIn()
          && isPlayerOwner(roomCode, playerId)
          && request.resource.data.keys().hasOnly(['teamId', 'targetPlayerId', 'electionAttempt', 'votedAt'])
          && room(roomCode).status == 'waiting'
          && room(roomCode).teamsLocked == true
          && request.resource.data.teamId == get(/databases/$(database)/documents/rooms/$(roomCode)/players/$(playerId)).data.teamId
          && request.resource.data.teamId == get(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.resource.data.targetPlayerId)).data.teamId
          && request.resource.data.electionAttempt == get(/databases/$(database)/documents/rooms/$(roomCode)/magic/$(request.resource.data.teamId)).data.captainElectionAttempt
          && get(/databases/$(database)/documents/rooms/$(roomCode)/magic/$(request.resource.data.teamId)).data.magicHolderPlayerId == null
        );
        allow delete: if false;
      }

      // Milestone 4.1: the broadly-readable counterpart to captainVotes above — same two-tier
      // split already established by players (private) vs answerProgress (safe/broad).
      // Deliberately carries no targetPlayerId, only "this player has voted this attempt" —
      // this is the entire X/Y voted-count signal, and nothing else.
      match /captainVoteProgress/{playerId} {
        allow read: if signedIn();
        allow write: if isTeacher(roomCode) || (
          signedIn()
          && isPlayerOwner(roomCode, playerId)
          && request.resource.data.keys().hasOnly(['teamId', 'electionAttempt', 'votedAt'])
          && room(roomCode).status == 'waiting'
          && room(roomCode).teamsLocked == true
          && request.resource.data.teamId == get(/databases/$(database)/documents/rooms/$(roomCode)/players/$(playerId)).data.teamId
          && request.resource.data.electionAttempt == get(/databases/$(database)/documents/rooms/$(roomCode)/magic/$(request.resource.data.teamId)).data.captainElectionAttempt
          && get(/databases/$(database)/documents/rooms/$(roomCode)/magic/$(request.resource.data.teamId)).data.magicHolderPlayerId == null
        );
        allow delete: if false;
      }

      // Team guardian name: captain-editable, teacher-resettable/overridable display name for a
      // locked team, replacing the generic "ทีม N" label everywhere once set. A new, isolated
      // collection — not layered onto rooms/rosters, both of which stay exactly as
      // teacher-only as before — so this is the only rule in the file this feature changes;
      // nothing existing is broadened. Only create/update are captain-reachable; delete is
      // teacher-only ("teacher may reset"), split out explicitly rather than folded into a
      // blanket allow write. Full charset/uniqueness validation lives in the application-layer
      // transaction (firebaseService.ts/demoService.ts both read every sibling team's current
      // name inside the same transaction before writing — that read-set is what actually
      // prevents two captains racing to the same name via Firestore's transaction-retry
      // semantics; rules have no loop/aggregate primitive to scan sibling docs for a duplicate).
      // Length is checked here too as a cheap backstop; the full character-set allowlist is left
      // to the app layer since it doesn't change the authorization boundary.
      match /teamNames/{teamId} {
        allow read: if signedIn();
        allow create, update: if isTeacher(roomCode) || (
          signedIn()
          && room(roomCode).status == 'waiting'
          && room(roomCode).teamsLocked == true
          && isPlayerOwner(roomCode, get(/databases/$(database)/documents/rooms/$(roomCode)/magic/$(teamId)).data.magicHolderPlayerId)
          && request.resource.data.keys().hasOnly(['teamId', 'name', 'updatedAt', 'updatedByPlayerId'])
          && request.resource.data.teamId == teamId
          && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 20
          && request.resource.data.updatedByPlayerId == get(/databases/$(database)/documents/rooms/$(roomCode)/magic/$(teamId)).data.magicHolderPlayerId
          && request.resource.data.updatedAt == request.time
        );
        allow delete: if isTeacher(roomCode);
      }
    }
  }
}
